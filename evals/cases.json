    "diff_lines": [
      "--- /dev/null",
      "+++ b/app.py",
      "@@ -0,0 +1,2 @@",
      "+def run(user_input):",
      "+    return eval(user_input)"
    ],
    "expected": [
      {"file": "app.py", "line": 2, "category": "security", "severity": "critical", "note": "eval() on untrusted input"}
    ],
    "notes": "Classic arbitrary-code-execution risk."
  },
